<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" stylesheets="@../css/Style.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.jm.sportlife.controller.RegisterController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Usuario" />
        
        <VBox maxWidth="300.0" spacing="8.0">
            <children>
                <Label text="Nombre:" />
                <TextField fx:id="txtFieldNombre" />
                
                <Label text="Apellido:" />
                <TextField fx:id="txtFieldApellido" />
                
                <Label text="Correo Electrónico:" />
                <TextField fx:id="txtFieldEmail" />
                
                <Label text="Contraseña:" />
                <PasswordField fx:id="txtFieldPass" />
                
                <Label text="Confirmar Contraseña:" />
                <PasswordField fx:id="txtFieldConfirmPass" />
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button onAction="#handleRegister" text="Crear Cuenta" />
                <Button onAction="#handleGoToLogin" text="Volver al Login" />
            </children>
        </HBox>
    </children>
</VBox>