<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" stylesheets="@../css/Style.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.jm.sportlife.controller.InstalacionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Instalaciones - SportLife" />
        
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Deporte:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbDeporte" prefWidth="180.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                
                <Label text="Precio / Hora ($):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtPrecioHora" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                
                <Label text="Techada:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <CheckBox fx:id="chkTechada" text="Es área techada" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <HBox spacing="10.0">
            <children>
                <Button onAction="#guardarInstalacion" text="Guardar / Modificar" />
                <Button onAction="#eliminarInstalacion" text="Eliminar" />
                <Button onAction="#limpiarFormulario" text="Limpiar" />
            </children>
        </HBox>

        <TableView fx:id="tvInstalacion" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tvColumnIdInstalacion" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="tvColumnCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="tvColumnDescripcion" prefWidth="180.0" text="Descripción" />
                <TableColumn fx:id="tvColumnDeporte" prefWidth="120.0" text="Deporte" />
                <TableColumn fx:id="tvColumnTechada" prefWidth="80.0" text="Techada" />
                <TableColumn fx:id="tvColumnPrecioHora" prefWidth="100.0" text="Precio / Hr" />
            </columns>
        </TableView>
    </children>
</VBox>